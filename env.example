# Copy to .env and fill in. NEVER commit the real .env.
# Google AI Studio key WITH billing enabled (owner pays per use)
GEMINI_API_KEY=AIza...
# Long random string for the admin panel (top-up endpoint).
# On Render you can leave this empty and use "Generate value" instead.
ADMIN_KEY=change-me-to-something-long-and-random
# Server port (Render sets PORT automatically — leave as is)
PORT=3000
# SQLite file location. On Render with a disk: /data/saas.db
DB_PATH=./saas.db
# Optional: lock the API to your pages only (comma-separated, no spaces).
# Example: ALLOWED_ORIGINS=https://cmkrecapstudio.blogspot.com
ALLOWED_ORIGINS=
